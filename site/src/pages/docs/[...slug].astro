---
import { render, type CollectionEntry } from 'astro:content';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import { Step, Steps } from 'fumadocs-ui/components/steps';
import type { TOCItemType } from 'fumadocs-core/toc';
import { Docs, SITE_TITLE } from '@/components/docs';
import { headingComponents } from '@/components/heading';
import { Screenshot } from '@/components/screenshot';
import Layout from '@/components/layout.astro';
import { source } from '@/lib/source';

interface Props {
	page: CollectionEntry< 'docs' >;
}

export async function getStaticPaths() {
	return source.getPages().map( ( page ) => ( {
		params: { slug: page.slugs.length > 0 ? page.slugs.join( '/' ) : undefined },
		props: { page: page.data._raw },
	} ) );
}

const { page } = Astro.props;
const { Content, headings } = await render( page );

const toc: TOCItemType[] = headings.map( ( heading ) => ( {
	depth: heading.depth,
	title: heading.text,
	url: '#' + heading.slug,
} ) );
---

<Layout title={ `${ page.data.title } | ${ SITE_TITLE }` } description={ page.data.description }>
	<Docs
		tree={ source.getPageTree() }
		pathname={ Astro.url.pathname }
		params={ Astro.params }
		page={ { toc } }
		client:load
	>
		<h1 class="font-semibold text-3xl">{ page.data.title }</h1>
		<p class="text-lg text-fd-muted-foreground mb-8">{ page.data.description }</p>
		<div class="prose flex-1">
			<Content components={ { ...defaultMdxComponents, ...headingComponents, Screenshot, Step, Steps } } />
		</div>
	</Docs>
</Layout>
