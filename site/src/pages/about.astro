---
import Layout from '@/components/layout.astro';
import { SITE_TITLE } from '@/components/docs';
import { About, ABOUT_DESCRIPTION } from '@/components/about';
---

<Layout title={ `About ${ SITE_TITLE }` } description={ ABOUT_DESCRIPTION }>
	<About pathname={ Astro.url.pathname } params={ Astro.params } client:load />
</Layout>
