{
	"name": "newspack-rolling-coverage",
	"version": "0.1.0",
	"description": "Live blog and rolling coverage of ongoing news events for Newspack",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/newspack-rolling-coverage.git"
	},
	"bugs": {
		"url": "https://github.com/Automattic/newspack-rolling-coverage/issues"
	},
	"homepage": "https://github.com/Automattic/newspack-rolling-coverage#readme",
	"scripts": {
		"cm": "git-cz",
		"semantic-release": "newspack-scripts release --files=newspack-rolling-coverage.php",
		"clean": "rm -rf dist",
		"build": "npm run clean && newspack-scripts wp-scripts build",
		"start": "npm ci && npm run watch",
		"watch": "npm run clean && newspack-scripts wp-scripts start",
		"typecheck": "tsc --noEmit",
		"test": "echo 'No JS unit tests in this repository.'",
		"lint": "npm run lint:scss && npm run lint:js && npm run lint:php && npm run typecheck",
		"lint:js": "newspack-scripts wp-scripts lint-js '**/{src,includes}/**/*.{js,jsx,ts,tsx}'",
		"lint:js:staged": "newspack-scripts wp-scripts lint-js --ext .js,.jsx,.ts,.tsx",
		"fix:js": "newspack-scripts wp-scripts lint-js --fix '**/{src,includes}/**/*.{js,jsx,ts,tsx}'",
		"format:js": "newspack-scripts wp-scripts format '**/{src,includes}/**/*.{js,jsx,ts,tsx}'",
		"test:php": "./vendor/bin/phpunit",
		"lint:php": "./vendor/bin/phpcs",
		"lint:php:staged": "./vendor/bin/phpcs --filter=GitStaged",
		"fix:php": "./vendor/bin/phpcbf",
		"lint:scss": "newspack-scripts wp-scripts lint-style '**/{src,includes}/**/*.scss' --customSyntax postcss-scss",
		"lint:scss:staged": "newspack-scripts wp-scripts lint-style --customSyntax postcss-scss",
		"format:scss": "newspack-scripts wp-scripts lint-style '**/{src,includes}/**/*.scss' --customSyntax postcss-scss --fix",
		"release": "npm run build && npm run semantic-release",
		"release:archive": "npm run build && composer install --no-dev --optimize-autoloader && rm -rf release && mkdir -p release && rsync -r . ./release/newspack-rolling-coverage --exclude-from='./.distignore' --exclude='release' && cd release && zip -r newspack-rolling-coverage.zip newspack-rolling-coverage && cd .. && composer install"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "npm run lint:js:staged",
		"*.scss": "npm run lint:scss:staged",
		"*.php": "npm run lint:php:staged"
	},
	"overrides": {
		"newspack-components": {
			"@wordpress/api-fetch": "^7.55.0",
			"@wordpress/base-styles": "^6.20.0",
			"@wordpress/components": "^40.1.0",
			"@wordpress/compose": "^8.8.0",
			"@wordpress/data": "^10.55.0",
			"@wordpress/dataviews": "^19.1.0",
			"@wordpress/dom-ready": "^4.55.0",
			"@wordpress/element": "^8.7.0",
			"@wordpress/hooks": "^4.55.0",
			"@wordpress/html-entities": "^4.55.0",
			"@wordpress/i18n": "^6.28.0",
			"@wordpress/icons": "^16.0.0",
			"@wordpress/keycodes": "^4.55.0",
			"@wordpress/url": "^4.55.0"
		}
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.55.0",
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/block-library": "^11.0.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/core-data": "^8.0.0",
		"@wordpress/data": "^10.55.0",
		"@wordpress/dataviews": "^19.1.0",
		"@wordpress/date": "^5.55.0",
		"@wordpress/editor": "^15.0.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/notices": "^5.55.0",
		"@wordpress/ui": "^0.22.0",
		"newspack-scripts": "^5.11.0",
		"react-router": "^7.18.0"
	},
	"dependencies": {
		"newspack-components": "~4.8.0",
		"newspack-icons": "~1.1.2"
	}
}
