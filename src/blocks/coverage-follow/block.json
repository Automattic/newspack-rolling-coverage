{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-rolling-coverage/coverage-follow",
	"title": "Coverage Follow Button",
	"category": "widgets",
	"description": "Lets readers follow this coverage to receive push notifications for new entries. Rendered once at the top of the coverage.",
	"textdomain": "newspack-rolling-coverage",
	"parent": [ "newspack-rolling-coverage/rolling-coverage" ],
	"attributes": {
		"coverageId": { "type": "number", "default": 0 },
		"status": { "type": "string", "default": "active" }
	},
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"align": true,
		"color": {
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./view.css"
}
