{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-rolling-coverage/coverage-follow",
	"title": "Follow Coverage",
	"category": "newspack",
	"description": "Lets readers follow a coverage to get push notifications of new entries.",
	"textdomain": "newspack-rolling-coverage",
	"usesContext": [
		"postId",
		"postType",
		"newspack-rolling-coverage/coverageId",
		"newspack-rolling-coverage/coverageStatus"
	],
	"attributes": {
		"coverageId": { "type": "number", "default": 0 }
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js"
}
