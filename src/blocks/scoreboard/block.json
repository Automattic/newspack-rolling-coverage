{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-rolling-coverage/scoreboard",
	"title": "Scoreboard",
	"category": "newspack",
	"description": "Shows a liveblog's score and keeps it current: the one around it, a chosen one, or else the one this page or breakout post belongs to. Stays hidden until the liveblog has a score.",
	"textdomain": "newspack-rolling-coverage",
	"keywords": [ "score", "match", "liveblog" ],
	"usesContext": [
		"postId",
		"postType",
		"newspack-rolling-coverage/coverageId"
	],
	"attributes": {
		"coverageId": {
			"type": "number",
			"default": 0
		},
		"showStatusAsBadge": {
			"type": "boolean",
			"default": false
		},
		"showDot": {
			"type": "boolean",
			"default": true
		},
		"backgroundColors": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": false,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"layout": {
			"allowSwitching": false,
			"allowEditing": false,
			"allowInheriting": false
		},
		"__experimentalStyle": {
			"spacing": {
				"blockGap": "var:preset|spacing|20"
			}
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./view.css"
}
