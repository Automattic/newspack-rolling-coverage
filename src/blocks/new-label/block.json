{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-rolling-coverage/new-label",
	"title": "New Label",
	"category": "newspack",
	"description": "Marks an entry that arrives while the reader has the page open, until they have seen it.",
	"textdomain": "newspack-rolling-coverage",
	"ancestor": [ "newspack-rolling-coverage/rolling-coverage" ],
	"attributes": {
		"content": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"visuallyHidden": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"text": true,
			"background": false,
			"link": false,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
