{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-rolling-coverage/rolling-coverage",
	"title": "Rolling Coverage",
	"category": "newspack",
	"description": "Displays the live entries of a rolling coverage, with polling for new entries and infinite scroll for older ones.",
	"textdomain": "newspack-rolling-coverage",
	"attributes": {
		"coverageId": {
			"type": "number",
			"default": 0
		},
		"pollInterval": {
			"type": "number",
			"default": 10
		},
		"entriesPerPage": {
			"type": "number",
			"default": 20
		},
		"enableAds": {
			"type": "boolean",
			"default": true
		},
		"adsInterval": {
			"type": "number",
			"default": 4
		},
		"archivedNoticeShow": {
			"type": "boolean",
			"default": true
		},
		"archivedNotice": {
			"type": "string",
			"default": ""
		},
		"archivedNoticeShowLink": {
			"type": "boolean",
			"default": true
		},
		"archivedNoticeLinkUrl": {
			"type": "string",
			"default": ""
		},
		"archivedNoticeLinkLabel": {
			"type": "string",
			"default": ""
		},
		"layoutId": {
			"type": "number",
			"default": 0
		},
		"latestOnly": {
			"type": "boolean",
			"default": false
		},
		"latestCount": {
			"type": "number",
			"default": 5
		},
		"allUpdatesLink": {
			"type": "boolean",
			"default": true
		},
		"hideWhenEnded": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": true,
		"anchor": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"style": "file:./view.css"
}
