{
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"lib": [ "ESNext", "DOM", "DOM.Iterable" ],
		"target": "es6",
		"module": "ESNext",
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"strict": true,
		"isolatedModules": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": false,
		"paths": {
			"@wordpress/block-editor": [ "./src/global.d.ts" ],
			"@wordpress/block-library": [ "./src/global.d.ts" ]
		}
	},
	"include": [ "src/**/*.ts", "src/**/*.tsx" ]
}
